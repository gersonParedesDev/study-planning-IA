{
  "name": "study-planning-ia-monorepo",
  "private": true,
  "scripts": {
    "---------------- SETUP ----------------": "",
    "install:all": "yarn install:python && yarn install:next",
    "install:python": "cd domain && poetry install && cd ../infrastructure && poetry install && cd ../apps/api && poetry install",
    "install:next": "cd apps/frontend && yarn install",

    "---------------- BUILD (AGREGA ESTO) ----------------": "",
    "build:domain": "cd domain && poetry build",
    "build:infra": "cd infrastructure && poetry build", 
    "build:all": "yarn build:domain && yarn build:infra",

    "---------------- TESTING ----------------": "",
    "test:backend": "cd domain && poetry run pytest -v",
    "test:frontend": "cd apps/frontend && yarn test", 
    "test:all": "yarn test:backend && yarn test:frontend",

    "---------------- RUNNING ----------------": "",
    "dev:api": "cd apps/api && poetry run uvicorn main:app --reload --port 8000",
    "dev:web": "cd apps/frontend && yarn dev",
    "dev": "concurrently \"yarn api\" \"yarn web\"",
    "api": "cd apps/api && export PYTHONPATH=$PYTHONPATH:../../domain/src:../../infrastructure/src:../../ && poetry run uvicorn main:app --reload --port 8000",
    "web": "cd apps/frontend && yarn dev",
    "shell": "cd apps/api && poetry run bash",
    "shell:domain": "cd domain && poetry run bash",
    "shell:infra": "cd infrastructure && poetry run bash"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}